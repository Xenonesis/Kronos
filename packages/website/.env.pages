# The Pages deployment serves the site from the `/Kronos/` subpath, so the
# production build emits `/Kronos/`-prefixed asset and route URLs.
#
# The default build (and the e2e suite, which previews the same app at the
# server root) leaves the base unset so it stays "/". Vite loads `.env.pages`
# only for `vite build --mode pages`, which is what `npm run build:pages` runs.
VITE_BASE_PATH=/Kronos/
VITE_SITE_HOST=https://xenonesis.github.io/Kronos
