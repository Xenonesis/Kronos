{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "fetch_agent_history_request"
    },
    "requestId": {
      "type": "string"
    },
    "filter": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "projectKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["initializing", "idle", "running", "error", "closed"]
          }
        },
        "includeArchived": {
          "type": "boolean"
        },
        "requiresAttention": {
          "type": "boolean"
        },
        "thinkingOptionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "includeInternal": {
          "type": "boolean"
        },
        "includeBackground": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "search": {
      "type": "string"
    },
    "sort": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": ["status_priority", "created_at", "updated_at", "title"]
          },
          "direction": {
            "type": "string",
            "enum": ["asc", "desc"]
          }
        },
        "required": ["key", "direction"],
        "additionalProperties": false
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["limit"],
      "additionalProperties": false
    }
  },
  "required": ["type", "requestId"],
  "additionalProperties": false
}
