{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "wait_for_finish_request"
    },
    "requestId": {
      "type": "string"
    },
    "agentId": {
      "type": "string"
    },
    "timeoutMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["type", "requestId", "agentId"],
  "additionalProperties": false
}
