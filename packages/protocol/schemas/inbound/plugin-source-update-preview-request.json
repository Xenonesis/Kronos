{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "plugin.source.update.preview.request"
    },
    "requestId": {
      "type": "string"
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "git"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "ref"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "npm"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "version"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["type", "requestId"],
  "additionalProperties": false
}
