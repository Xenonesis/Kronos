{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agent.fork_context.request"
    },
    "agentId": {
      "type": "string"
    },
    "boundaryCursor": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["epoch", "seq"],
      "additionalProperties": false
    },
    "boundaryMessageId": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "agentId", "requestId"],
  "additionalProperties": false
}
