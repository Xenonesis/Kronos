{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "plugin.catalog.get.request"
    },
    "requestId": {
      "type": "string"
    },
    "cachedClientBundles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "clientBundleHash": {
            "type": "string"
          }
        },
        "required": ["id", "clientBundleHash"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "requestId"],
  "additionalProperties": false
}
