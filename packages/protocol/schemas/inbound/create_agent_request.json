{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "create_agent_request"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "config": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "modeId": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "thinkingOptionId": {
          "type": "string"
        },
        "featureValues": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "providerOptions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "toolPolicy": {
          "type": "object",
          "properties": {
            "preapproved": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "mcp"
                  },
                  "server": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["kind", "server", "tool"],
                "additionalProperties": false
              }
            }
          },
          "required": ["preapproved"],
          "additionalProperties": false
        },
        "systemPrompt": {
          "type": "string"
        },
        "mcpServers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "stdio"
                  },
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "command"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "http"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "sse"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "url"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["provider", "cwd"],
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "workspaceId": {
      "type": "string"
    },
    "callerAgentId": {
      "type": "string"
    },
    "worktreeName": {
      "type": "string"
    },
    "initialPrompt": {
      "type": "string"
    },
    "clientMessageId": {
      "type": "string"
    },
    "outputSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "required": ["data", "mimeType"],
        "additionalProperties": false
      }
    },
    "attachments": {},
    "git": {
      "type": "object",
      "properties": {
        "baseBranch": {
          "type": "string"
        },
        "createNewBranch": {
          "type": "boolean"
        },
        "newBranchName": {
          "type": "string"
        },
        "createWorktree": {
          "type": "boolean"
        },
        "worktreeSlug": {
          "type": "string"
        },
        "refName": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": ["branch-off", "checkout"]
        },
        "checkoutSource": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "change_request"
            },
            "forge": {
              "type": "string"
            },
            "number": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "projectPath": {
              "type": "string"
            }
          },
          "required": ["kind", "number"],
          "additionalProperties": false
        },
        "githubPrNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "worktree": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "branch-off"
            },
            "newBranch": {
              "type": "string",
              "minLength": 1
            },
            "base": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["mode", "newBranch"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "checkout-branch"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["mode", "branch"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "checkout-pr"
            },
            "prNumber": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["mode", "prNumber"],
          "additionalProperties": false
        }
      ]
    },
    "autoArchive": {
      "type": "boolean"
    },
    "internal": {
      "type": "boolean"
    },
    "background": {
      "type": "boolean"
    },
    "labels": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "config", "labels", "requestId"],
  "additionalProperties": false
}
