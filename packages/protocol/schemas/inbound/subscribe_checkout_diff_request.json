{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "subscribe_checkout_diff_request"
    },
    "subscriptionId": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "compare": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["uncommitted", "base", "all"]
        },
        "baseRef": {
          "type": "string"
        },
        "ignoreWhitespace": {
          "type": "boolean"
        }
      },
      "required": ["mode"],
      "additionalProperties": false
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "cwd", "compare", "requestId"],
  "additionalProperties": false
}
