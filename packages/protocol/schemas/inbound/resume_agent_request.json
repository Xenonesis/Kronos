{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "resume_agent_request"
    },
    "handle": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "nativeHandle": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": ["provider", "sessionId"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "overrides": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "modeId": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "thinkingOptionId": {
          "type": "string"
        },
        "featureValues": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "providerOptions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "toolPolicy": {
          "type": "object",
          "properties": {
            "preapproved": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "mcp"
                  },
                  "server": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["kind", "server", "tool"],
                "additionalProperties": false
              }
            }
          },
          "required": ["preapproved"],
          "additionalProperties": false
        },
        "systemPrompt": {
          "type": "string"
        },
        "mcpServers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "stdio"
                  },
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "command"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "http"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "sse"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "url"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "handle", "requestId"],
  "additionalProperties": false
}
