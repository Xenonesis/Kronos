{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "file.upload.request"
    },
    "fileName": {
      "type": "string",
      "minLength": 1
    },
    "mimeType": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "modifiedAt": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "fileName", "mimeType", "size", "modifiedAt", "requestId"],
  "additionalProperties": false
}
