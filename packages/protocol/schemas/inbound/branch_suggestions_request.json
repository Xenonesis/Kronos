{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "branch_suggestions_request"
    },
    "cwd": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "cwd", "requestId"],
  "additionalProperties": false
}
