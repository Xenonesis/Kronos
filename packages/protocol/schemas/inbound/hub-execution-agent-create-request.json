{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "hub.execution.agent.create.request"
    },
    "requestId": {
      "type": "string"
    },
    "executionId": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "modeId": {
      "type": "string"
    },
    "thinkingOptionId": {
      "type": "string"
    },
    "featureValues": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "providerOptions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "toolPolicy": {
      "type": "object",
      "properties": {
        "preapproved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "mcp"
              },
              "server": {
                "type": "string",
                "minLength": 1
              },
              "tool": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind", "server", "tool"],
            "additionalProperties": false
          }
        }
      },
      "required": ["preapproved"],
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "stdio"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "alwaysLoad": {
                "type": "boolean"
              }
            },
            "required": ["type", "command"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "http"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "alwaysLoad": {
                "type": "boolean"
              }
            },
            "required": ["type", "url"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "sse"
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "alwaysLoad": {
                "type": "boolean"
              }
            },
            "required": ["type", "url"],
            "additionalProperties": false
          }
        ]
      }
    },
    "worktree": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "branch-off"
            },
            "newBranch": {
              "type": "string",
              "minLength": 1
            },
            "base": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["mode", "newBranch"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "checkout-branch"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["mode", "branch"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "checkout-pr"
            },
            "prNumber": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["mode", "prNumber"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["type", "requestId", "executionId", "provider", "cwd", "prompt"],
  "additionalProperties": false
}
