{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "ping"
    },
    "requestId": {
      "type": "string"
    },
    "clientSentAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": ["type", "requestId"],
  "additionalProperties": false
}
