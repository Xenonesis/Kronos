{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "directory_suggestions_request"
    },
    "query": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "includeFiles": {
      "type": "boolean"
    },
    "includeDirectories": {
      "type": "boolean"
    },
    "matchMode": {
      "type": "string",
      "enum": ["fuzzy", "suffix"]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "query", "requestId"],
  "additionalProperties": false
}
