{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wholeTurns": {
      "type": "boolean"
    },
    "type": {
      "type": "string",
      "const": "fetch_agent_timeline_request"
    },
    "agentId": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": ["tail", "before", "after"]
    },
    "cursor": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["epoch", "seq"],
      "additionalProperties": false
    },
    "limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projection": {
      "type": "string",
      "enum": ["projected", "canonical"]
    },
    "mergeWindow": {
      "type": "boolean"
    }
  },
  "required": ["type", "agentId", "requestId"],
  "additionalProperties": false
}
