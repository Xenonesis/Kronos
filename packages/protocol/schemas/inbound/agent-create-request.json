{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agent.create.request"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "config": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "modeId": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "thinkingOptionId": {
          "type": "string"
        },
        "featureValues": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "providerOptions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "toolPolicy": {
          "type": "object",
          "properties": {
            "preapproved": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "mcp"
                  },
                  "server": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["kind", "server", "tool"],
                "additionalProperties": false
              }
            }
          },
          "required": ["preapproved"],
          "additionalProperties": false
        },
        "systemPrompt": {
          "type": "string"
        },
        "mcpServers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "stdio"
                  },
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "command"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "http"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "url"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "sse"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "url"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["provider", "cwd"],
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "workspaceId": {
      "type": "string"
    },
    "callerAgentId": {
      "type": "string"
    },
    "worktreeName": {
      "type": "string"
    },
    "initialPrompt": {
      "type": "string"
    },
    "clientMessageId": {
      "type": "string"
    },
    "outputSchema": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "required": ["data", "mimeType"],
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "forge_change_request"
              },
              "mimeType": {
                "type": "string",
                "const": "application/paseo-forge-change-request"
              },
              "forge": {
                "default": "github",
                "type": "string"
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "body": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "projectPath": {
                "type": "string"
              },
              "baseRefName": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "headRefName": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["type", "mimeType", "forge", "number", "title", "url"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "forge_issue"
              },
              "mimeType": {
                "type": "string",
                "const": "application/paseo-forge-issue"
              },
              "forge": {
                "default": "github",
                "type": "string"
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "body": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "projectPath": {
                "type": "string"
              }
            },
            "required": ["type", "mimeType", "forge", "number", "title", "url"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "github_pr"
              },
              "mimeType": {
                "type": "string",
                "const": "application/github-pr"
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "body": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "baseRefName": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "headRefName": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["type", "mimeType", "number", "title", "url"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "github_issue"
              },
              "mimeType": {
                "type": "string",
                "const": "application/github-issue"
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "body": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["type", "mimeType", "number", "title", "url"],
            "additionalProperties": false
          },
          {},
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "review"
              },
              "mimeType": {
                "type": "string",
                "const": "application/paseo-review"
              },
              "cwd": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": ["uncommitted", "base", "all"]
              },
              "baseRef": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "comments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "filePath": {
                      "type": "string"
                    },
                    "side": {
                      "type": "string",
                      "enum": ["old", "new"]
                    },
                    "lineNumber": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "body": {
                      "type": "string"
                    },
                    "context": {
                      "type": "object",
                      "properties": {
                        "hunkHeader": {
                          "type": "string"
                        },
                        "targetLine": {
                          "type": "object",
                          "properties": {
                            "oldLineNumber": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "newLineNumber": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "type": {
                              "type": "string",
                              "enum": ["add", "remove", "context"]
                            },
                            "content": {
                              "type": "string"
                            }
                          },
                          "required": ["oldLineNumber", "newLineNumber", "type", "content"],
                          "additionalProperties": false
                        },
                        "lines": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "oldLineNumber": {
                                "anyOf": [
                                  {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "newLineNumber": {
                                "anyOf": [
                                  {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "type": {
                                "type": "string",
                                "enum": ["add", "remove", "context"]
                              },
                              "content": {
                                "type": "string"
                              }
                            },
                            "required": ["oldLineNumber", "newLineNumber", "type", "content"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["hunkHeader", "targetLine", "lines"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["filePath", "side", "lineNumber", "body", "context"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type", "mimeType", "cwd", "mode", "comments"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "uploaded_file"
              },
              "id": {
                "type": "string"
              },
              "fileName": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["type", "id", "fileName", "mimeType", "size", "path"],
            "additionalProperties": false
          }
        ]
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "baseBranch": {
          "type": "string"
        },
        "createNewBranch": {
          "type": "boolean"
        },
        "newBranchName": {
          "type": "string"
        },
        "createWorktree": {
          "type": "boolean"
        },
        "worktreeSlug": {
          "type": "string"
        },
        "refName": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": ["branch-off", "checkout"]
        },
        "checkoutSource": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "change_request"
            },
            "forge": {
              "type": "string"
            },
            "number": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "projectPath": {
              "type": "string"
            }
          },
          "required": ["kind", "number"],
          "additionalProperties": false
        },
        "githubPrNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "worktree": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "branch-off"
            },
            "newBranch": {
              "type": "string",
              "minLength": 1
            },
            "base": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["mode", "newBranch"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "checkout-branch"
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["mode", "branch"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "checkout-pr"
            },
            "prNumber": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["mode", "prNumber"],
          "additionalProperties": false
        }
      ]
    },
    "autoArchive": {
      "type": "boolean"
    },
    "internal": {
      "type": "boolean"
    },
    "background": {
      "type": "boolean"
    },
    "labels": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "requestId": {
      "type": "string"
    },
    "agentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "subscribe": {
      "type": "boolean"
    }
  },
  "required": ["type", "config", "labels", "requestId"],
  "additionalProperties": false
}
