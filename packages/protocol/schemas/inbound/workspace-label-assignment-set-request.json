{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "workspace.label.assignment.set.request"
    },
    "requestId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "label": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "enum": [
            "violet",
            "sky",
            "emerald",
            "orange",
            "pink",
            "indigo",
            "teal",
            "red",
            "amber",
            "blue"
          ]
        }
      },
      "required": ["name", "color"],
      "additionalProperties": false
    },
    "assigned": {
      "type": "boolean"
    }
  },
  "required": ["type", "requestId", "workspaceId", "label", "assigned"],
  "additionalProperties": false
}
