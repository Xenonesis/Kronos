{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "workspace.github.search_repositories.request"
    },
    "query": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "query", "requestId"],
  "additionalProperties": false
}
