{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "send_agent_message_request"
    },
    "requestId": {
      "type": "string"
    },
    "agentId": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "sourceAgentId": {
      "type": "string",
      "minLength": 1
    },
    "sourceAgentServerId": {
      "type": "string",
      "minLength": 1
    },
    "sessionMode": {
      "type": "string"
    },
    "messageId": {
      "type": "string"
    },
    "activeTurnBehavior": {
      "type": "string",
      "enum": ["interrupt", "steer"]
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "required": ["data", "mimeType"],
        "additionalProperties": false
      }
    },
    "attachments": {}
  },
  "required": ["type", "requestId", "agentId", "text"],
  "additionalProperties": false
}
