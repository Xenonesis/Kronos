{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "open_in_editor_request"
    },
    "path": {
      "type": "string"
    },
    "editorId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["open", "reveal"]
    },
    "cwd": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "path", "editorId", "requestId"],
  "additionalProperties": false
}
