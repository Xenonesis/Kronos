{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "capture_terminal_request"
    },
    "terminalId": {
      "type": "string"
    },
    "start": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "end": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "stripAnsi": {
      "default": true,
      "type": "boolean"
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "terminalId", "stripAnsi", "requestId"],
  "additionalProperties": false
}
