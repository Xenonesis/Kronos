{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "write_project_config_request"
    },
    "requestId": {
      "type": "string"
    },
    "repoRoot": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "properties": {
        "worktree": {
          "type": "object",
          "properties": {
            "setup": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "teardown": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "terminals": {},
            "servicePorts": {
              "type": "object",
              "properties": {
                "range": {
                  "type": "string",
                  "pattern": "^(\\d{1,5})-(\\d{1,5})$"
                },
                "portScript": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": {}
        },
        "scripts": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {},
              "command": {},
              "port": {}
            },
            "additionalProperties": {}
          }
        },
        "metadataGeneration": {
          "default": {},
          "type": "object",
          "properties": {
            "title": {
              "default": {},
              "type": "object",
              "properties": {
                "instructions": {
                  "type": "string"
                }
              },
              "additionalProperties": {}
            },
            "branchName": {
              "default": {},
              "type": "object",
              "properties": {
                "instructions": {
                  "type": "string"
                }
              },
              "additionalProperties": {}
            },
            "commitMessage": {
              "default": {},
              "type": "object",
              "properties": {
                "instructions": {
                  "type": "string"
                }
              },
              "additionalProperties": {}
            },
            "pullRequest": {
              "default": {},
              "type": "object",
              "properties": {
                "instructions": {
                  "type": "string"
                }
              },
              "additionalProperties": {}
            }
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
    },
    "expectedRevision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "mtimeMs": {
              "type": "number"
            },
            "size": {
              "type": "number"
            }
          },
          "required": ["mtimeMs", "size"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["type", "requestId", "repoRoot", "config", "expectedRevision"],
  "additionalProperties": false
}
