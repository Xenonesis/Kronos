{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "creation.subscribe.request"
    },
    "requestId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": ["workspace", "agent"]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "subscribe": {
      "type": "boolean"
    }
  },
  "required": ["type", "requestId", "kind", "idempotencyKey"],
  "additionalProperties": false
}
