{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "workspace.label.update.request"
    },
    "requestId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "newName": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "enum": [
        "violet",
        "sky",
        "emerald",
        "orange",
        "pink",
        "indigo",
        "teal",
        "red",
        "amber",
        "blue"
      ]
    }
  },
  "required": ["type", "requestId", "name"],
  "additionalProperties": false
}
