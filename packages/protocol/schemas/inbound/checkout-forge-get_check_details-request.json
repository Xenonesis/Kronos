{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cwd": {
      "type": "string"
    },
    "repoOwner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "repoName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "checkRunId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "workflowRunId": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "changeRequestNumber": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "requestId": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "checkout.forge.get_check_details.request"
    }
  },
  "required": ["cwd", "requestId", "type"],
  "additionalProperties": false
}
