      "type": "string",
      "const": "checkout_pr_merge_request"
    },
    "cwd": {
      "type": "string"
    },
    "mergeMethod": {
      "type": "string",
      "enum": ["merge", "squash", "rebase"]
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "cwd", "mergeMethod", "requestId"],
  "additionalProperties": false
}
