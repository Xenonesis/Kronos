{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "workspace.label.list.request"
    },
    "requestId": {
      "type": "string"
    },
    "subscribe": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sync": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string"
        },
        "afterSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["generation", "afterSeq"],
      "additionalProperties": false
    }
  },
  "required": ["type", "requestId"],
  "additionalProperties": false
}
