{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "chat/read"
    },
    "requestId": {
      "type": "string"
    },
    "room": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "since": {
      "type": "string"
    },
    "authorAgentId": {
      "type": "string"
    }
  },
  "required": ["type", "requestId", "room"],
  "additionalProperties": false
}
