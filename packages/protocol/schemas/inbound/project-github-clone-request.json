{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "project.github.clone.request"
    },
    "repo": {
      "type": "string",
      "minLength": 3
    },
    "cloneProtocol": {
      "type": "string",
      "enum": ["https", "ssh"]
    },
    "targetDirectory": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "repo", "targetDirectory", "requestId"],
  "additionalProperties": false
}
