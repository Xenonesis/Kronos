{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agent.config.apply.request"
    },
    "agentId": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "properties": {
        "modelId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "modeId": {
          "type": "string"
        },
        "thinkingOptionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "featureValues": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "agentId", "config", "requestId"],
  "additionalProperties": false
}
