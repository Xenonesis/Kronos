{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "schedule/create"
    },
    "requestId": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "cadence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "every"
            },
            "everyMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["type", "everyMs"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "cron"
            },
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["type", "expression"],
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "self"
            },
            "agentId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
            }
          },
          "required": ["type", "agentId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "agent"
            },
            "agentId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
            }
          },
          "required": ["type", "agentId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "new-agent"
            },
            "config": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "cwd": {
                  "type": "string",
                  "minLength": 1
                },
                "modeId": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "thinkingOptionId": {
                  "type": "string",
                  "minLength": 1
                },
                "archiveOnFinish": {
                  "type": "boolean"
                },
                "isolation": {
                  "type": "string",
                  "enum": ["local", "worktree"]
                },
                "title": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "providerOptions": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "featureValues": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "systemPrompt": {
                  "type": "string"
                },
                "mcpServers": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": ["provider", "cwd"],
              "additionalProperties": false
            }
          },
          "required": ["type", "config"],
          "additionalProperties": false
        }
      ]
    },
    "maxRuns": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "string"
    },
    "runOnCreate": {
      "type": "boolean"
    }
  },
  "required": ["type", "requestId", "prompt", "cadence", "target"],
  "additionalProperties": false
}
