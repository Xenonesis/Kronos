{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "loop/logs"
    },
    "requestId": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "afterSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["type", "requestId", "id"],
  "additionalProperties": false
}
