{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "plugin.source.install.request"
    },
    "requestId": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "pluginPath": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["type", "requestId", "source"],
  "additionalProperties": false
}
