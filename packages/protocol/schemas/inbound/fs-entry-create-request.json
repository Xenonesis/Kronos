{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "fs.entry.create.request"
    },
    "cwd": {
      "type": "string"
    },
    "parentPath": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": ["file", "directory"]
    },
    "requestId": {
      "type": "string"
    }
  },
  "required": ["type", "cwd", "parentPath", "name", "kind", "requestId"],
  "additionalProperties": false
}
