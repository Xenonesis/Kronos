{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "create_terminal_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "terminal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "cwd": {
                  "type": "string"
                },
                "workspaceId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "activity": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "state": {
                          "default": "idle",
                          "type": "string",
                          "enum": ["idle", "working", "attention"]
                        },
                        "attentionReason": {
                          "default": null,
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": ["finished", "needs_input"]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "changedAt": {
                          "type": "number"
                        }
                      },
                      "required": ["state", "changedAt"],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["id", "name", "cwd"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["terminal", "error", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
