{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agent.fork_context.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "attachment": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "boundaryMessageId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "boundaryCursor": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "epoch": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["epoch", "seq"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "agentId", "attachment", "itemCount", "boundaryMessageId", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
