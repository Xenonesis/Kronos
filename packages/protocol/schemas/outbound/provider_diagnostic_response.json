{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "provider_diagnostic_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "diagnostic": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["provider", "diagnostic", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
