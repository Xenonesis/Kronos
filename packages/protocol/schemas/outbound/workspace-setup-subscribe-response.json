{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "workspace.setup.subscribe.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "subscriptionId": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["running", "completed", "failed", "blocked"]
                },
                "detail": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "worktree_setup"
                    },
                    "worktreePath": {
                      "type": "string"
                    },
                    "branchName": {
                      "type": "string"
                    },
                    "log": {
                      "type": "string"
                    },
                    "commands": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "command": {
                            "type": "string"
                          },
                          "cwd": {
                            "type": "string"
                          },
                          "log": {
                            "default": "",
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["running", "completed", "failed"]
                          },
                          "exitCode": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "durationMs": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": ["index", "command", "cwd", "log", "status", "exitCode"],
                        "additionalProperties": false
                      }
                    },
                    "truncated": {
                      "type": "boolean"
                    }
                  },
                  "required": ["type", "worktreePath", "branchName", "log", "commands"],
                  "additionalProperties": false
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "blockedSource": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "change_request"
                    },
                    "forge": {
                      "type": "string"
                    },
                    "number": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "headRepository": {
                      "type": "string"
                    }
                  },
                  "required": ["kind", "forge", "number", "headRepository"],
                  "additionalProperties": false
                }
              },
              "required": ["status", "detail", "error"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "workspaceId", "snapshot"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
