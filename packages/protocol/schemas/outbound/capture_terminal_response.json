{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "capture_terminal_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "terminalId": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "totalLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["terminalId", "lines", "totalLines", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
