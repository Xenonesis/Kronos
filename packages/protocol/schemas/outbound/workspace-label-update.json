{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "workspace.label.update"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "subscriptionId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "upsert"
            },
            "label": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "violet",
                    "sky",
                    "emerald",
                    "orange",
                    "pink",
                    "indigo",
                    "teal",
                    "red",
                    "amber",
                    "blue"
                  ]
                }
              },
              "required": ["name", "color"],
              "additionalProperties": false
            },
            "previousName": {
              "type": "string"
            },
            "generation": {
              "type": "string"
            },
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["kind", "label", "generation", "seq"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "subscriptionId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "remove"
            },
            "name": {
              "type": "string"
            },
            "generation": {
              "type": "string"
            },
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["kind", "name", "generation", "seq"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
