{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "checkout_pr_status_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "forge": {
                  "default": "github",
                  "type": "string"
                },
                "projectPath": {
                  "type": "string"
                },
                "number": {
                  "type": "number"
                },
                "url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "baseRefName": {
                  "type": "string"
                },
                "headRefName": {
                  "type": "string"
                },
                "isMerged": {
                  "type": "boolean"
                },
                "isDraft": {
                  "default": false,
                  "type": "boolean"
                },
                "mergeable": {
                  "default": "UNKNOWN",
                  "type": "string",
                  "enum": ["MERGEABLE", "CONFLICTING", "UNKNOWN"]
                },
                "checks": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "url": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "workflow": {
                        "type": "string"
                      },
                      "duration": {
                        "type": "string"
                      },
                      "checkRunId": {
                        "type": "number"
                      },
                      "workflowRunId": {
                        "type": "number"
                      },
                      "traits": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": ["name", "status", "url"],
                    "additionalProperties": false
                  }
                },
                "checksStatus": {
                  "type": "string"
                },
                "reviewDecision": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "repoOwner": {
                  "type": "string"
                },
                "repoName": {
                  "type": "string"
                },
                "github": {
                  "type": "object",
                  "properties": {
                    "mergeStateStatus": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "autoMergeRequest": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "enabledAt": {
                              "default": null,
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "mergeMethod": {
                              "default": null,
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "enabledBy": {
                              "default": null,
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": ["enabledAt", "mergeMethod", "enabledBy"],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "viewerCanEnableAutoMerge": {
                      "default": false,
                      "type": "boolean"
                    },
                    "viewerCanDisableAutoMerge": {
                      "default": false,
                      "type": "boolean"
                    },
                    "viewerCanMergeAsAdmin": {
                      "default": false,
                      "type": "boolean"
                    },
                    "viewerCanUpdateBranch": {
                      "default": false,
                      "type": "boolean"
                    },
                    "repository": {
                      "default": {
                        "autoMergeAllowed": false,
                        "mergeCommitAllowed": false,
                        "squashMergeAllowed": false,
                        "rebaseMergeAllowed": false,
                        "viewerDefaultMergeMethod": null
                      },
                      "type": "object",
                      "properties": {
                        "autoMergeAllowed": {
                          "default": false,
                          "type": "boolean"
                        },
                        "mergeCommitAllowed": {
                          "default": false,
                          "type": "boolean"
                        },
                        "squashMergeAllowed": {
                          "default": false,
                          "type": "boolean"
                        },
                        "rebaseMergeAllowed": {
                          "default": false,
                          "type": "boolean"
                        },
                        "viewerDefaultMergeMethod": {
                          "default": null,
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "autoMergeAllowed",
                        "mergeCommitAllowed",
                        "squashMergeAllowed",
                        "rebaseMergeAllowed",
                        "viewerDefaultMergeMethod"
                      ],
                      "additionalProperties": false
                    },
                    "isMergeQueueEnabled": {
                      "default": false,
                      "type": "boolean"
                    },
                    "isInMergeQueue": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "mergeStateStatus",
                    "autoMergeRequest",
                    "viewerCanEnableAutoMerge",
                    "viewerCanDisableAutoMerge",
                    "viewerCanMergeAsAdmin",
                    "viewerCanUpdateBranch",
                    "repository",
                    "isMergeQueueEnabled",
                    "isInMergeQueue"
                  ],
                  "additionalProperties": false
                },
                "forgeSpecific": {}
              },
              "required": [
                "forge",
                "url",
                "title",
                "state",
                "baseRefName",
                "headRefName",
                "isMerged",
                "isDraft",
                "mergeable",
                "checks"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "githubFeaturesEnabled": {
          "type": "boolean"
        },
        "authState": {},
        "forge": {
          "default": "github",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": ["NOT_GIT_REPO", "NOT_ALLOWED", "MERGE_CONFLICT", "UNKNOWN"]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["code", "message"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["cwd", "status", "githubFeaturesEnabled", "forge", "error", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
