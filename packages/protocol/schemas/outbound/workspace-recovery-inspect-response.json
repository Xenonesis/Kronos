{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "workspace.recovery.inspect.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "state": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "recoverable"
                },
                "workspaceId": {
                  "type": "string"
                },
                "workspaceName": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "branch": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["kind", "workspaceId", "workspaceName", "action", "branch"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "unavailable"
                },
                "workspaceId": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["kind", "workspaceId", "reason", "message"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["requestId", "state"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
