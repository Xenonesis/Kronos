{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "daemon.get_pairing_offer.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "qr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relayEnabled": {
          "type": "boolean"
        }
      },
      "required": ["requestId", "url", "relayEnabled"],
      "additionalProperties": {}
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
