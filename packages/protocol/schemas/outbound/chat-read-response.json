{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "chat/read/response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "roomId": {
                "type": "string"
              },
              "authorAgentId": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "replyToMessageId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mentionAgentIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "roomId",
              "authorAgentId",
              "body",
              "replyToMessageId",
              "mentionAgentIds",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "messages", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
