{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "get_daemon_config_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "properties": {
            "relay": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "requireProtectedSecurity": {
                  "type": "boolean"
                }
              },
              "required": ["enabled"],
              "additionalProperties": {}
            },
            "mcp": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "injectIntoAgents": {
                  "type": "boolean"
                }
              },
              "required": ["injectIntoAgents"],
              "additionalProperties": {}
            },
            "hostnames": {
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "cors": {
              "type": "object",
              "properties": {
                "allowedOrigins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["allowedOrigins"],
              "additionalProperties": {}
            },
            "trustedProxies": {
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "git": {
              "type": "object",
              "properties": {
                "maxProcessesPerSecond": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxProcessConcurrency": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["maxProcessesPerSecond", "maxProcessConcurrency"],
              "additionalProperties": false
            },
            "app": {
              "type": "object",
              "properties": {
                "baseUrl": {
                  "type": "string"
                }
              },
              "required": ["baseUrl"],
              "additionalProperties": false
            },
            "catalogRefreshTimeoutMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "usage": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": ["enabled"],
              "additionalProperties": false
            },
            "browserTools": {
              "default": {
                "enabled": false
              },
              "type": "object",
              "properties": {
                "enabled": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": ["enabled"],
              "additionalProperties": {}
            },
            "providers": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "paseoTools": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "disabledTools": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "additionalModels": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        },
                        "isDefault": {
                          "type": "boolean"
                        }
                      },
                      "required": ["id", "label"],
                      "additionalProperties": {}
                    }
                  }
                },
                "additionalProperties": {}
              }
            },
            "metadataGeneration": {
              "default": {
                "providers": []
              },
              "type": "object",
              "properties": {
                "providers": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      },
                      "thinkingOptionId": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": ["provider"],
                    "additionalProperties": {}
                  }
                }
              },
              "required": ["providers"],
              "additionalProperties": {}
            },
            "autoArchiveAfterMerge": {
              "default": false,
              "type": "boolean"
            },
            "enableTerminalAgentHooks": {
              "default": false,
              "type": "boolean"
            },
            "idleRuntimeCleanup": {
              "type": "boolean"
            },
            "resumeOnStartup": {
              "type": "boolean"
            },
            "resumePrompt": {
              "type": "string"
            },
            "appendSystemPrompt": {
              "default": "",
              "type": "string"
            },
            "terminalProfiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "icon": {
                    "type": "string"
                  }
                },
                "required": ["id", "name", "command"],
                "additionalProperties": {}
              }
            },
            "agentProfiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "modeId": {
                    "type": "string"
                  },
                  "thinkingOptionId": {
                    "type": "string"
                  },
                  "featureValues": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": ["id", "name", "provider"],
                "additionalProperties": {}
              }
            },
            "skills": {
              "type": "object",
              "properties": {
                "selection": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "const": "all"
                        }
                      },
                      "required": ["mode"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "const": "custom"
                        },
                        "skills": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": ["mode", "skills"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "pluginsEnabled": {
              "type": "boolean"
            },
            "plugins": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "directory"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "enabled": {
                        "type": "boolean"
                      }
                    },
                    "required": ["source", "path"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "features": {
              "type": "object",
              "properties": {
                "dictation": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "stt": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "const": "local"
                            },
                            "model": {
                              "type": "string"
                            },
                            "language": {
                              "type": "string"
                            }
                          },
                          "required": ["provider"],
                          "additionalProperties": {}
                        },
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "const": "openai"
                            },
                            "model": {
                              "type": "string"
                            },
                            "hasApiKey": {
                              "type": "boolean"
                            },
                            "baseUrl": {
                              "type": "string"
                            },
                            "language": {
                              "type": "string"
                            },
                            "confidenceThreshold": {
                              "type": "number"
                            }
                          },
                          "required": ["provider", "hasApiKey"],
                          "additionalProperties": {}
                        },
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string"
                            },
                            "model": {
                              "type": "string"
                            }
                          },
                          "required": ["provider"],
                          "additionalProperties": {}
                        }
                      ]
                    }
                  },
                  "required": ["enabled", "stt"],
                  "additionalProperties": {}
                },
                "voiceMode": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "stt": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "const": "local"
                            },
                            "model": {
                              "type": "string"
                            },
                            "language": {
                              "type": "string"
                            }
                          },
                          "required": ["provider"],
                          "additionalProperties": {}
                        },
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "const": "openai"
                            },
                            "model": {
                              "type": "string"
                            },
                            "hasApiKey": {
                              "type": "boolean"
                            },
                            "baseUrl": {
                              "type": "string"
                            },
                            "language": {
                              "type": "string"
                            },
                            "confidenceThreshold": {
                              "type": "number"
                            }
                          },
                          "required": ["provider", "hasApiKey"],
                          "additionalProperties": {}
                        },
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string"
                            },
                            "model": {
                              "type": "string"
                            }
                          },
                          "required": ["provider"],
                          "additionalProperties": {}
                        }
                      ]
                    },
                    "tts": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "const": "local"
                            },
                            "model": {
                              "type": "string"
                            },
                            "speakerId": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "speed": {
                              "type": "number"
                            }
                          },
                          "required": ["provider"],
                          "additionalProperties": {}
                        },
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string",
                              "const": "openai"
                            },
                            "model": {
                              "type": "string"
                            },
                            "hasApiKey": {
                              "type": "boolean"
                            },
                            "baseUrl": {
                              "type": "string"
                            },
                            "voice": {
                              "type": "string"
                            }
                          },
                          "required": ["provider", "hasApiKey"],
                          "additionalProperties": {}
                        },
                        {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string"
                            },
                            "model": {
                              "type": "string"
                            }
                          },
                          "required": ["provider"],
                          "additionalProperties": {}
                        }
                      ]
                    },
                    "llm": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "model": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": {}
                    },
                    "turnDetection": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": ["enabled", "stt", "tts"],
                  "additionalProperties": {}
                }
              },
              "required": ["dictation", "voiceMode"],
              "additionalProperties": {}
            },
            "envOverrides": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "mcp",
            "browserTools",
            "providers",
            "metadataGeneration",
            "autoArchiveAfterMerge",
            "enableTerminalAgentHooks",
            "appendSystemPrompt"
          ],
          "additionalProperties": {}
        }
      },
      "required": ["requestId", "config"],
      "additionalProperties": {}
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
