{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "workspace.label.update.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "label": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "color": {
              "type": "string",
              "enum": [
                "violet",
                "sky",
                "emerald",
                "orange",
                "pink",
                "indigo",
                "teal",
                "red",
                "amber",
                "blue"
              ]
            }
          },
          "required": ["name", "color"],
          "additionalProperties": false
        },
        "affectedWorkspaceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["requestId", "label", "affectedWorkspaceCount"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
