{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "project.update"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "subscriptionId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "upsert"
            },
            "project": {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string"
                },
                "projectKey": {
                  "type": "string"
                },
                "projectDisplayName": {
                  "type": "string"
                },
                "projectCustomName": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "projectCustomIconRevision": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "projectIconRevision": {
                  "type": "string"
                },
                "projectRootPath": {
                  "type": "string"
                },
                "projectKind": {
                  "type": "string",
                  "enum": ["git", "non_git", "directory"]
                },
                "syncSeq": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["projectId", "projectDisplayName", "projectRootPath", "projectKind"],
              "additionalProperties": false
            },
            "generation": {
              "type": "string"
            },
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["kind", "project"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "subscriptionId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "remove"
            },
            "projectId": {
              "type": "string"
            },
            "generation": {
              "type": "string"
            },
            "seq": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["kind", "projectId"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
