{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "loop/run/response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "loop": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "prompt": {
                  "type": "string"
                },
                "cwd": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "modeId": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "workerProvider": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "workerModel": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verifierProvider": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verifierModel": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verifierModeId": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verifyPrompt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verifyChecks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "archive": {
                  "type": "boolean"
                },
                "sleepMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "maxIterations": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxTimeMs": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": ["running", "succeeded", "failed", "stopped"]
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "startedAt": {
                  "type": "string"
                },
                "completedAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stopRequestedAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "iterations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "workerAgentId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "workerStartedAt": {
                        "type": "string"
                      },
                      "workerCompletedAt": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "verifierAgentId": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "status": {
                        "type": "string",
                        "enum": ["running", "succeeded", "failed", "stopped"]
                      },
                      "workerOutcome": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": ["completed", "failed", "canceled"]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "failureReason": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "verifyChecks": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "command": {
                              "type": "string"
                            },
                            "exitCode": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            },
                            "passed": {
                              "type": "boolean"
                            },
                            "stdout": {
                              "type": "string"
                            },
                            "stderr": {
                              "type": "string"
                            },
                            "startedAt": {
                              "type": "string"
                            },
                            "completedAt": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "command",
                            "exitCode",
                            "passed",
                            "stdout",
                            "stderr",
                            "startedAt",
                            "completedAt"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "verifyPrompt": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "passed": {
                                "type": "boolean"
                              },
                              "reason": {
                                "type": "string"
                              },
                              "verifierAgentId": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "startedAt": {
                                "type": "string"
                              },
                              "completedAt": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "passed",
                              "reason",
                              "verifierAgentId",
                              "startedAt",
                              "completedAt"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "index",
                      "workerAgentId",
                      "workerStartedAt",
                      "workerCompletedAt",
                      "verifierAgentId",
                      "status",
                      "workerOutcome",
                      "failureReason",
                      "verifyChecks",
                      "verifyPrompt"
                    ],
                    "additionalProperties": false
                  }
                },
                "logs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "seq": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "timestamp": {
                        "type": "string"
                      },
                      "iteration": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "source": {
                        "type": "string",
                        "enum": ["loop", "worker", "verifier", "verify-check"]
                      },
                      "level": {
                        "type": "string",
                        "enum": ["info", "error"]
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": ["seq", "timestamp", "iteration", "source", "level", "text"],
                    "additionalProperties": false
                  }
                },
                "nextLogSeq": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "activeIteration": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "activeWorkerAgentId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "activeVerifierAgentId": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "prompt",
                "cwd",
                "provider",
                "model",
                "modeId",
                "workerProvider",
                "workerModel",
                "verifierProvider",
                "verifierModel",
                "verifierModeId",
                "verifyPrompt",
                "verifyChecks",
                "archive",
                "sleepMs",
                "maxIterations",
                "maxTimeMs",
                "status",
                "createdAt",
                "updatedAt",
                "startedAt",
                "completedAt",
                "stopRequestedAt",
                "iterations",
                "logs",
                "nextLogSeq",
                "activeIteration",
                "activeWorkerAgentId",
                "activeVerifierAgentId"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "loop", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
