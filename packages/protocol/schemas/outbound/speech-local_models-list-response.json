{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "speech.local_models.list.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "downloadSizeBytes": {
                "type": "number"
              },
              "isDefault": {
                "type": "boolean"
              },
              "inUse": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              },
              "receivedBytes": {
                "type": "number"
              },
              "totalBytes": {
                "type": "number"
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "label",
              "description",
              "languages",
              "downloadSizeBytes",
              "isDefault",
              "inUse",
              "status"
            ],
            "additionalProperties": {}
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "models", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
