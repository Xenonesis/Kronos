{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "fs.file.subscribe.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string"
        },
        "initial": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "ready"
                },
                "cwd": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modifiedAt": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["text", "image", "binary"]
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": ["status", "cwd", "path", "size", "modifiedAt"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "missing"
                },
                "cwd": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": ["status", "cwd", "path"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "error"
                },
                "cwd": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": ["status", "cwd", "path", "error"],
              "additionalProperties": false
            }
          ]
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["subscriptionId", "initial", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
