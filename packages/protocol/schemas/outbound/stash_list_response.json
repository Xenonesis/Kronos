{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "stash_list_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "message": {
                "type": "string"
              },
              "branch": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "isPaseo": {
                "type": "boolean"
              }
            },
            "required": ["index", "message", "branch", "isPaseo"],
            "additionalProperties": false
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": ["NOT_GIT_REPO", "NOT_ALLOWED", "MERGE_CONFLICT", "UNKNOWN"]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["code", "message"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["cwd", "entries", "error", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
