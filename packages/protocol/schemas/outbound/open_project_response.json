{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "open_project_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "workspace": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "enum": ["directory_not_found"]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "workspace", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
