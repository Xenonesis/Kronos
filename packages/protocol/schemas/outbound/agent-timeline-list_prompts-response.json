{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agent.timeline.list_prompts.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "epoch": {
          "type": "string"
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "timestamp": {
                "type": "string"
              },
              "preview": {
                "type": "string"
              }
            },
            "required": ["seq", "timestamp", "preview"],
            "additionalProperties": false
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "agentId", "epoch", "prompts", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
