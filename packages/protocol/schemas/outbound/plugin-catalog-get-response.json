{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "plugin.catalog.get.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "clientBundle": {
                "type": "string"
              },
              "clientBundleHash": {
                "type": "string"
              },
              "requirements": {
                "type": "object",
                "properties": {
                  "paseo": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "required": ["id"],
            "additionalProperties": false
          }
        }
      },
      "required": ["requestId", "plugins"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
