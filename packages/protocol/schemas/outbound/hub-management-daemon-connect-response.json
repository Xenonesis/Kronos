{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "hub.management.daemon.connect.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "status": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not_connected",
                "connecting",
                "connected",
                "reconnecting",
                "disconnecting",
                "revoked"
              ]
            },
            "daemonId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hubOrigin": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "daemon.read",
                  "daemon.manage",
                  "tunnel.manage",
                  "access.manage",
                  "workspace.read",
                  "workspace.write",
                  "workspace.manage",
                  "automation.manage",
                  "hub.execute"
                ]
              }
            },
            "connectedAt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastError": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["state", "daemonId", "hubOrigin", "permissions", "connectedAt", "lastError"],
          "additionalProperties": false
        }
      },
      "required": ["requestId", "status"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
