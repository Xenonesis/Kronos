{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "file_explorer_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["list", "file"]
        },
        "directory": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": ["file", "directory"]
                      },
                      "size": {
                        "type": "number"
                      },
                      "modifiedAt": {
                        "type": "string"
                      }
                    },
                    "required": ["name", "path", "kind", "size", "modifiedAt"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["path", "entries"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["text", "image", "binary"]
                },
                "encoding": {
                  "type": "string",
                  "enum": ["utf-8", "base64", "none"]
                },
                "content": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                },
                "modifiedAt": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                }
              },
              "required": ["path", "kind", "encoding", "size", "modifiedAt"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["cwd", "path", "mode", "directory", "file", "error", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
