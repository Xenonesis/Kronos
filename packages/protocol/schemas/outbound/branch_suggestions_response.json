{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "branch_suggestions_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "branches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branchDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "committerDate": {
                "type": "number"
              },
              "hasLocal": {
                "type": "boolean"
              },
              "hasRemote": {
                "type": "boolean"
              },
              "localAhead": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "localBehind": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["name", "committerDate"],
            "additionalProperties": false
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["branches", "error", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
