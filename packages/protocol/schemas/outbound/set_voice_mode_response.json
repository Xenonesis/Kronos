{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "set_voice_mode_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "agentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "missingModelIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["requestId", "enabled", "agentId", "accepted", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
