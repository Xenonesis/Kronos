{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "activity_log"
    },
    "payload": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "timestamp": {},
        "type": {
          "type": "string",
          "enum": ["transcript", "assistant", "tool_call", "tool_result", "error", "system"]
        },
        "content": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["id", "timestamp", "type", "content"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
