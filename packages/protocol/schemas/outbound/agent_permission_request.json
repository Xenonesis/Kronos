                  "required": ["type", "worktreePath", "branchName", "log", "commands"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "shell"
                    },
                    "command": {
                      "type": "string"
                    },
                    "cwd": {
                      "type": "string"
                    },
                    "output": {
                      "type": "string"
                    },
                    "exitCode": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["type", "command"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "read"
                    },
                    "filePath": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "offset": {
                      "type": "number"
                    },
                    "limit": {
                      "type": "number"
                    }
                  },
                  "required": ["type", "filePath"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "edit"
                    },
                    "filePath": {
                      "type": "string"
                    },
                    "oldString": {
                      "type": "string"
                    },
                    "newString": {
                      "type": "string"
                    },
                    "unifiedDiff": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "filePath"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "write"
                    },
                    "filePath": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "filePath"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "search"
                    },
                    "query": {
                      "type": "string"
                    },
                    "toolName": {
                      "type": "string",
                      "enum": ["search", "grep", "glob", "web_search"]
