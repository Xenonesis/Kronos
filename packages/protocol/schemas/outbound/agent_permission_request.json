          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": ["tool", "plan", "question", "mode", "other"]
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "input": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "detail": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "worktree_setup"
                    },
                    "worktreePath": {
                      "type": "string"
                    },
                    "branchName": {
                      "type": "string"
                    },
                    "log": {
                      "type": "string"
                    },
                    "commands": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "command": {
                            "type": "string"
                          },
                          "cwd": {
                            "type": "string"
                          },
                          "log": {
                            "default": "",
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["running", "completed", "failed"]
                          },
                          "exitCode": {
                            "anyOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "durationMs": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": ["index", "command", "cwd", "log", "status", "exitCode"],
                        "additionalProperties": false
                      }
                    },
                    "truncated": {
                      "type": "boolean"
                    }
