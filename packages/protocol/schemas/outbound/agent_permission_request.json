                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "behavior": {
                    "type": "string",
                    "enum": ["allow", "deny"]
                  },
                  "variant": {
                    "type": "string",
                    "enum": ["primary", "secondary", "danger"]
                  },
                  "intent": {
                    "type": "string",
                    "enum": ["implement", "implement_resume", "dismiss"]
                  }
                },
                "required": ["id", "label", "behavior"],
                "additionalProperties": false
              }
            },
            "metadata": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
