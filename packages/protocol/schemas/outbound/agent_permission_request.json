{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "agent_permission_request"
    },
    "payload": {
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
