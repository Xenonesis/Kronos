                        "type": "string"
                      }
                    },
                    "numFiles": {
                      "type": "number"
                    },
                    "numMatches": {
                      "type": "number"
                    },
                    "durationMs": {
                      "type": "number"
                    },
                    "durationSeconds": {
                      "type": "number"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "mode": {
                      "type": "string",
                      "enum": ["content", "files_with_matches", "count"]
                    }
                  },
                  "required": ["type", "query"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "fetch"
                    },
                    "url": {
                      "type": "string"
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "result": {
                      "type": "string"
                    },
                    "code": {
                      "type": "number"
                    },
                    "codeText": {
                      "type": "string"
                    },
                    "bytes": {
                      "type": "number"
                    },
                    "durationMs": {
                      "type": "number"
                    }
                  },
                  "required": ["type", "url"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "sub_agent"
                    },
                    "subAgentType": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "childSessionId": {
                      "type": "string"
                    },
                    "log": {
                      "type": "string"
                    },
                    "actions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "toolName": {
                            "type": "string"
                          },
                          "summary": {
                            "type": "string"
                          }
                        },
                        "required": ["index", "toolName"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["type"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "plain_text"
                    },
                    "label": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "icon": {
                      "type": "string",
                      "enum": [
                        "wrench",
                        "square_terminal",
                        "eye",
                        "pencil",
                        "search",
                        "bot",
                        "sparkles",
                        "brain",
                        "mic_vocal"
                      ]
                    }
                  },
                  "required": ["type"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "plan"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": ["type", "text"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "unknown"
                    },
                    "input": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {}
                        },
                        {
                          "type": "object",
                          "properties": {},
                          "additionalProperties": {}
                        }
                      ]
                    },
                    "output": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {}
                        },
                        {
                          "type": "object",
                          "properties": {},
                          "additionalProperties": {}
                        }
                      ]
                    }
                  },
                  "required": ["type", "input", "output"],
                  "additionalProperties": false
                }
              ]
