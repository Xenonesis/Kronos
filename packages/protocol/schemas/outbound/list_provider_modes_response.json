{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "list_provider_modes_response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "colorTier": {
                "type": "string"
              }
            },
            "required": ["id", "label"],
            "additionalProperties": false
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fetchedAt": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      },
      "required": ["provider", "fetchedAt", "requestId"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
