{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "file.upload.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "uploaded_file"
                },
                "id": {
                  "type": "string"
                },
                "fileName": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "path": {
                  "type": "string"
                }
              },
              "required": ["type", "id", "fileName", "mimeType", "size", "path"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "file", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
