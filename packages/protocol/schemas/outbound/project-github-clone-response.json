{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "project.github.clone.response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "minLength": 3
        },
        "checkoutPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "project": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string"
                },
                "projectKey": {
                  "type": "string"
                },
                "projectDisplayName": {
                  "type": "string"
                },
                "projectCustomName": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "projectCustomIconRevision": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "projectIconRevision": {
                  "type": "string"
                },
                "projectRootPath": {
                  "type": "string"
                },
                "projectKind": {
                  "type": "string",
                  "enum": ["git", "non_git", "directory"]
                },
                "syncSeq": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["projectId", "projectDisplayName", "projectRootPath", "projectKind"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "repo", "checkoutPath", "project", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
