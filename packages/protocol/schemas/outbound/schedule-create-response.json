{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "schedule/create/response"
    },
    "payload": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "schedule": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "cadence": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "every"
                        },
                        "everyMs": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["type", "everyMs"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "cron"
                        },
                        "expression": {
                          "type": "string",
                          "minLength": 1
                        },
                        "timezone": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["type", "expression"],
                      "additionalProperties": false
                    }
                  ]
                },
                "target": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "agent"
                        },
                        "agentId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
                        }
                      },
                      "required": ["type", "agentId"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "new-agent"
                        },
                        "config": {
                          "type": "object",
                          "properties": {
                            "provider": {
                              "type": "string"
                            },
                            "cwd": {
                              "type": "string",
                              "minLength": 1
                            },
                            "modeId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "model": {
                              "type": "string",
                              "minLength": 1
                            },
                            "thinkingOptionId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "archiveOnFinish": {
                              "type": "boolean"
                            },
                            "isolation": {
                              "type": "string",
                              "enum": ["local", "worktree"]
                            },
                            "title": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "minLength": 1
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "providerOptions": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {}
                            },
                            "featureValues": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {}
                            },
                            "systemPrompt": {
                              "type": "string"
                            },
                            "mcpServers": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {}
                            }
                          },
                          "required": ["provider", "cwd"],
                          "additionalProperties": false
                        }
                      },
                      "required": ["type", "config"],
                      "additionalProperties": false
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": ["active", "paused", "completed"]
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                },
                "nextRunAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastRunAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pausedAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expiresAt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxRuns": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "prompt",
                "cadence",
                "target",
                "status",
                "createdAt",
                "updatedAt",
                "nextRunAt",
                "lastRunAt",
                "pausedAt",
                "expiresAt",
                "maxRuns"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["requestId", "schedule", "error"],
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"],
  "additionalProperties": false
}
