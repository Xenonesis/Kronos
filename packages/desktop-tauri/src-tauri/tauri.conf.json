{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kronos",
  "version": "0.16.0",
  "identifier": "sh.paseo.desktop.tauri",
  "build": {
    "beforeBuildCommand": "node prepare-build.mjs",
    "frontendDist": "../../../packages/app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws: wss: https:; img-src 'self' asset: http://asset.localhost data: blob: https: http:; font-src 'self' data:; media-src 'self' blob: data:; worker-src 'self' blob:; frame-src 'self' blob: data: http: https:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "publisher": "Kronos",
    "copyright": "Copyright © 2026 Kronos",
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "resources": ["../server-dist/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "installerHooks": "hooks/nsis-hooks.nsh",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "schemes": ["kronos", "paseo"]
    },
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Xenonesis/Kronos/releases/latest/download/latest.json"]
    }
  }
}
